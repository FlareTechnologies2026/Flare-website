# Contact form email delivery (Resend, https://resend.com)
RESEND_API_KEY=
# Where submissions are sent (default: marketing@flaretechnologies.in)
CONTACT_TO=marketing@flaretechnologies.in
# Sender. Must be on a domain verified in Resend, e.g. "Flare Website <no-reply@flaretechnologies.in>".
# Without a verified domain, Resend only allows onboarding@resend.dev and only delivers to your own Resend account email.
CONTACT_FROM=Flare Website <onboarding@resend.dev>

# Admin panel password (the code falls back to a default if unset; always set this in production)
ADMIN_PASSWORD=
